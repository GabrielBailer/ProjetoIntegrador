<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/fala_comigo_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/fala_comigo_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App_PI2">

        <activity
            android:name=".activity.MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="app-pi2.web.app" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.TelaLogin" />
        <activity android:name=".ui.NovoCadastro" />
        <activity android:name=".ui.RecuperarSenha" android:exported="false" />
        <activity android:name=".ui.NovaInteracao" />
        <activity android:name=".activity.PerfilActivity" />
        <activity android:name=".ui.Home" />


    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#C8C2C2"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_instrucao_codigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite o código enviado para o e-mail informado"
        android:textSize="18sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edit_codigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Código de verificação"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/tv_instrucao_codigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_confirmar_codigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmar código"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/edit_codigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

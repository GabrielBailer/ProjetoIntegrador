<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- TOPO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Perfil"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_perfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="303dp"
            android:layout_height="84dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_content_description"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_fc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnConfiguracoes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Configurações"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_config"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DIVIDER SUPERIOR -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#D8D8D8"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/dividerMiddle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_interacao" />

    <!-- DIVIDER INFERIOR -->
    <View
        android:id="@+id/dividerMiddle"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#D8D8D8"
        app:layout_constraintBottom_toTopOf="@id/searchView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BARRA DE BUSCA -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_busca"
        android:iconifiedByDefault="false"
        android:queryHint="Buscar interação..."
        app:layout_constraintBottom_toTopOf="@id/tvNaoEncontrado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvNaoEncontrado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Interação não encontrada!"
        android:textColor="#555555"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/boxFrase"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CAIXA DE FRASE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/boxFrase"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E9E9EE"
        app:layout_constraintBottom_toTopOf="@id/layoutAcoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvFraseMontada"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Toque nos cards para montar uma frase..."
            android:textColor="#7A7A86"
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>

    <!-- ÁREA DOS BOTÕES -->
    <LinearLayout
        android:id="@+id/layoutAcoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- FALAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFalar"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Falar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="#A9A9B2"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_falar"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- EDITAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditar"
            android:layout_width="56dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Editar"
            app:backgroundTint="#F2F2F2"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_editar"
            app:iconTint="#7A7A7A"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp" />

        <!-- DELETAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletar"
            android:layout_width="56dp"
            android:layout_height="60dp"
            android:contentDescription="Deletar"
            app:backgroundTint="#F2F2F2"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_apagar"
            app:iconTint="#7A7A7A"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="32dp">

        <!-- IMAGEM -->
        <ImageView
            android:background="@color/primary"
            android:id="@+id/imgInteracao"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/int_black_feliz" />

        <!-- TEXTO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecione uma cor:"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- CORES -->
        <RadioGroup
            android:id="@+id/rgCores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/corVermelho"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cor_vermelho"
                android:button="@null" />

            <RadioButton
                android:id="@+id/corLaranja"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cor_laranja"
                android:button="@null" />

            <RadioButton
                android:id="@+id/corAmarelo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cor_amarelo"
                android:button="@null" />

            <RadioButton
                android:id="@+id/corVerde"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cor_verde"
                android:button="@null" />

            <RadioButton
                android:id="@+id/corAzul"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cor_azul"
                android:button="@null" />

            <RadioButton
                android:id="@+id/corRoxo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/cor_roxo"
                android:button="@null" />

        </RadioGroup>

        <!-- INPUT -->
        <EditText
            android:id="@+id/etTituloInteracao"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:hint="Título da interação"
            android:background="@drawable/bg_edittext"
            android:paddingHorizontal="12dp" />

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btnSalvarInteracao"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Salvar"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
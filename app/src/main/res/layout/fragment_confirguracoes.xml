<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/btnFechar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"/>
    </RelativeLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tabAparencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aparência"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingEnd="16dp"/>

        <TextView
            android:id="@+id/tabSeguranca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Segurança"
            android:textColor="@color/text_secondary"/>
    </LinearLayout>

    <!-- LINHA INDICADORA -->
    <View
        android:id="@+id/indicadorTab"
        android:layout_width="80dp"
        android:layout_height="2dp"
        android:background="@color/text_primary"
        android:layout_marginTop="4dp"/>

    <!-- CARD MODO ESCURO -->
    <LinearLayout
        android:id="@+id/cardModoEscuro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Escuro"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvStatusModo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desativado"
                android:textColor="#888888"/>
        </LinearLayout>

        <Switch
            android:id="@+id/switchModoEscuro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardFalaDireta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desativar Fala Automática"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFalaAutomatica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desativado"
                android:textColor="#888888"/>
        </LinearLayout>

        <Switch
            android:id="@+id/switchFalaAutomatica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- CARD MODO RESPONSÁVEL -->
    <LinearLayout
        android:id="@+id/cardModoResponsavel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_card"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Modo Responsável"
            android:layout_weight="1"
            android:textStyle="bold"/>

        <Switch
            android:id="@+id/switchResponsavel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- CARD DESCRIÇÃO -->
    <TextView
        android:id="@+id/tvDescricaoConfiguracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        android:text="O modo escuro reduz o brilho da tela e pode ajudar a diminuir o cansaço visual, especialmente em ambientes com pouca luz."
        android:textColor="#555555"/>

</LinearLayout>